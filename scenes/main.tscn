[gd_scene load_steps=10 format=3 uid="uid://main_scene_sc3d_v2"]

[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="1_player"]
[ext_resource type="PackedScene" path="res://scenes/hud.tscn" id="2_hud"]
[ext_resource type="Script" path="res://scripts/level_generator.gd" id="3_lvlgen"]

[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Node3D

@onready var level_gen: Node = $LevelGenerator
@onready var camera: Camera3D = $CameraArm/Camera3D
@onready var player: CharacterBody3D = $Player
@onready var cam_arm: Node3D = $CameraArm

var _cam_offset: Vector3 = Vector3(0, 8, 14)
var _cam_lerp_speed: float = 4.0

func _ready() -> void:
	if GameManager:
		GameManager.level_completed.connect(_on_level_completed)
	# Gera o nível atual
	var lvl := 1
	if GameManager:
		lvl = GameManager.current_level
	level_gen.generate_level(self, lvl)

func _process(delta: float) -> void:
	if not is_instance_valid(player): return
	# Câmera segue o jogador com lerp suave
	var target_pos := player.global_position + _cam_offset
	cam_arm.global_position = cam_arm.global_position.lerp(target_pos, _cam_lerp_speed * delta)
	# Câmera reorienta com a direção da gravidade
	if GameManager:
		var grav := GameManager.gravity_direction
		var up := -grav if grav != Vector3.DOWN else Vector3.UP
		_cam_offset = (-grav * 8.0) + (Vector3.BACK * 14.0 if grav.x == 0 else Vector3.RIGHT * 14.0)

func _on_level_completed(_level: int) -> void:
	pass  # HUD gerencia painel de vitória
"

